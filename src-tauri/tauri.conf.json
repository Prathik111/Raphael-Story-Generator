{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raphael Story Generator",
  "version": "0.1.0",
  "identifier": "com.raphael.storygenerator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Raphael Story Generator",
        "width": 1500,
        "height": 920,
        "minWidth": 1050,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "AI story and manga scene generator",
    "longDescription": "Local-first story generation with persistent canon, private web research, chapter continuation, scene extraction and ComfyUI-ready image prompts.",
    "resources": {
      "../privacy-search/": "privacy-search/"
    }
  }
}